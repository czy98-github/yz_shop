# 标题
VITE_APP_TITLE=意象点餐管理系统

# 项目本地运行端口号
# 说明：上游默认为 80，需 root 权限且易与本机其它服务冲突；本地演示改为 3000
VITE_PORT=3000

# open 运行 npm run dev 时自动打开浏览器
VITE_OPEN=true

# 租户开关
VITE_APP_TENANT_ENABLE=false

# 验证码的开关
VITE_APP_CAPTCHA_ENABLE=true

# 文档地址的开关
VITE_APP_DOCALERT_ENABLE=true

# 百度统计
VITE_APP_BAIDU_CODE = a1ff8825baa73c3a78eb96aa40325abc

# 百度地图ak
VITE_BAIDU_MAP_AK = m1YRfvvQt9dPVNuPSieTEDgRhZkIznSn

# ---------------------------------------------------------------------------
# 后端接口地址（本地演示）—— 这一节是修「登录 404」的关键，勿删
#
# 原理：`pnpm dev` 等价于 `vite`，此时 mode 默认是 development，
#       只会加载 .env（+ .env.development / .env.local），**不会加载 .env.dev**。
#       只有 `pnpm dev-server`（= vite --mode dev）才会读 .env.dev。
#       若这里没配 VITE_BASE_URL，axios 的
#           base_url = VITE_BASE_URL + VITE_API_URL
#       会退化成 "undefined/admin-api"，登录请求打到 3000 端口 → 404。
#
# 处理：置空 VITE_BASE_URL，走 vite 的 server.proxy 同源转发（见 vite.config.ts）：
#           浏览器请求 /admin-api/**  →  vite(3000) 转发  →  后端(48081)
#       好处：不依赖局域网 IP，换网络 / IP 变动都不影响本机演示。
# ---------------------------------------------------------------------------
VITE_BASE_URL=
VITE_API_URL=/admin-api

# 文件上传地址（同样走同源代理）
VITE_UPLOAD_TYPE=server
VITE_UPLOAD_URL=/admin-api/infra/file/upload
